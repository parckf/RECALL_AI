# RecallAI Backend Environment Variables Template
FALKORDB_HOST=127.0.0.1
FALKORDB_PORT=6379
FALKORDB_PASSWORD=replace_with_a_strong_password

LLM_PROVIDER=gemini
# LLM Model options: gemini-3.8-flash, gemini-3.5-flash-lite, gemini-2.5-flash, gpt-4o-mini, etc.
LLM_MODEL=gemini-3.8-flash
GEMINI_API_KEY=replace_with_your_gemini_api_key

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

SUPABASE_URL=
SUPABASE_SECRET_KEY=sb_secret_replace_with_your_server_key
