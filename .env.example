# RecallAI Root Environment Variables Template
# Copy to .env or backend/.env and fill in real values. NEVER commit files containing secrets.

# FalkorDB Graph Database Configuration
FALKORDB_HOST=127.0.0.1
FALKORDB_PORT=6379
FALKORDB_PASSWORD=replace_with_a_strong_password

# LLM Configuration (backend/app/services/llm_client.py)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.8-flash
GEMINI_API_KEY=replace_with_your_gemini_api_key

# Alternative provider fallback (optional)
# OPENAI_API_KEY=
# GROQ_API_KEY=

# CORS Configuration (comma-separated list of explicit origins, no wildcards)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional chat transcript persistence. Keep the secret key backend-only.
SUPABASE_URL=
SUPABASE_SECRET_KEY=sb_secret_replace_with_your_server_key
