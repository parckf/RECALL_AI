# RecallAI Frontend Public Environment Variables
# Copy to .env.local for local overrides. NEVER put secrets in Vite environment variables.

# Backend API base URL
VITE_API_BASE_URL=http://127.0.0.1:8000

# API Mode: "mock" (offline in-memory demo) or "live" (backend server on 127.0.0.1:8000)
VITE_API_MODE=mock
